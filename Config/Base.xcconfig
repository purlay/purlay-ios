PRODUCT_BUNDLE_IDENTIFIER = dev.purlay.ios
PRODUCT_NAME = Purlay
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// The floor. iOS 26 and later get Liquid Glass from the system; earlier releases get the quiet fallback in PurlayDesign.
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
// The scheme the sign-in hands the session back through: fixed by the server (`NATIVE_REDIRECT`).
PURLAY_URL_SCHEME = purlay
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_PREPROCESS = YES
PURLAY_PLIST_DEFINITIONS =
INFOPLIST_PREPROCESSOR_DEFINITIONS = $(PURLAY_PLIST_DEFINITIONS)
INFOPLIST_FILE = App/Resources/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
